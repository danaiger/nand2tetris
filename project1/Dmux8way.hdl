CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in=sel[0] , out=notsel0 );
    Not(in=sel[1] , out=notsel1 );
    Not(in=sel[2] , out=notsel2 );
    DMux4Way(in=in , sel=sel[1..2] , a=grupab , b=groupcd , c=groupef , d=groupgh );
    DMux(in=grupab , sel=sel[0] , a=a , b=b );
    DMux(in=groupcd , sel=sel[0] , a=c , b=d );
    DMux(in=groupef , sel=sel[0] , a=e , b=f );
    DMux(in=groupgh , sel=sel[0] , a=g , b=h );
}